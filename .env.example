# SolarChip Configuration File
# Copy this file to .env and adjust values for your installation.

# Geographical coordinates of your solar panel installation
# (Default is Chennai, India)
LATITUDE=13.0827
LONGITUDE=80.2707
LOCATION_NAME=Chennai, India

# Rated peak power of your solar panel in Watts (STC - Standard Test Conditions)
# For the student prototype educational panel, default is 10.0 W
PANEL_RATED_WATTS=10.0

# Server network binding
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
